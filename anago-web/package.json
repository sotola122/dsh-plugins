{
  "name": "@anago-harness/anago-web",
  "description": "Web UI layer for anago profiles: the web-search provider settings cards.",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@anago-harness/client-ui-fonts-anago": "workspace:*",
    "@anago-harness/client-ui-session-share": "workspace:*",
    "@anago-harness/client-ui-settings-web-search": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-web-search": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sotola122/dsh-plugins.git",
    "directory": "anago-web"
  }
}
